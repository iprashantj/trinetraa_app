APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# App\Support\Reminders sends via the Resend HTTP API (not SMTP/sendmail),
# since some hosts disable stream_socket_client/proc_open.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=onboarding@resend.dev
RESEND_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Required: min 32 chars. Generate with: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=

# ─── Customer messaging (all optional; without them staff send via wa.me / sms: links) ───
# WhatsApp Cloud API (Meta). Free-form text only reaches customers inside WhatsApp's 24-hour window;
# set WHATSAPP_TEMPLATE to an approved template name to message anyone.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en
# SMS via MSG91 Flow API. India needs a DLT-registered sender ID and template; the message goes in as variable "message".
MSG91_AUTH_KEY=
MSG91_SENDER=
MSG91_TEMPLATE_ID=
# Site-wide Google review link (a branch can have its own review link instead)
GOOGLE_REVIEW_URL=
